{
  "schema": 1,
  "job_id": "xlio-20261125-172406-font-sizes",
  "package": "xlio",
  "purpose": "font_sizes: open workbooks whose font has a fractional size, read A1's Font.Size while open, save an .xlsx copy",
  "requires": {
    "excel_build_min": {
      "windows": "16.0.20527.0"
    },
    "edition": "Microsoft 365"
  },
  "limits": {
    "job_seconds": 1800,
    "step_seconds": 300
  },
  "on_refused_open": "record",
  "control": "control.xlsx",
  "audit": false,
  "workbooks": [
    {
      "file": "size00.xlsx",
      "steps": [
        {
          "op": "open"
        },
        {
          "op": "read_format",
          "range": "A1",
          "props": [
            "font.size"
          ]
        },
        {
          "op": "save_as",
          "name": "size00.saved.xlsx",
          "format": "xlsx"
        }
      ]
